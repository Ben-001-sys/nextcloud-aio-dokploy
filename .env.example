# COPY TO .env IN EACH ROOTLESS USER'S OWN WORKING DIRECTORY.
# Ben example:
AIO_ADMIN_PORT=8080
AIO_APACHE_PORT=11000
AIO_TALK_PORT=3478

# Other rootless user needs different values, for example:
# AIO_ADMIN_PORT=8081
# AIO_APACHE_PORT=11001
# AIO_TALK_PORT=3479

# XDG_RUNTIME_DIR is supplied by a REAL SSH login and should point to
# /run/user/<that user's UID>. Do not hardcode it into a shared repo.
# Do not put secrets, backup encryption keys, or credentials in Git.
